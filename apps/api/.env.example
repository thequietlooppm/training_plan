# Port the Fastify server listens on.
PORT=3001

# Host to bind to.
HOST=0.0.0.0

# apps/web origin(s) allowed by CORS — comma-separated, so local dev
# (http://localhost:5173) and a real deployed web origin can both be
# allowed at once, e.g.:
# WEB_APP_ORIGIN=http://localhost:5173,https://training-plan-web-dev.pages.dev
WEB_APP_ORIGIN=http://localhost:5173
